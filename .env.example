# Copy to .env and fill in real values. Never commit the real .env file —
# see docs/SECURITY.md section 7. This file documents variable names only;
# it must never contain a real secret.
#
# Frontend variables live separately in src/Frontend/dpdp-web/.env.example
# (Vite only reads .env files from its own project directory).

# --- ASP.NET Core host --------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development

# --- Database -------------------------------------------------------------
# Double-underscore is ASP.NET Core's configuration-key separator, i.e.
# this sets ConnectionStrings:Default. PostgreSQL must already exist —
# see docs/DEVELOPMENT.md for local setup.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=dpdp_compass;Username=dpdp_compass_app1;Password=CHANGE_ME

# --- CORS -------------------------------------------------------------
# One allowed browser origin per Cors__AllowedOrigins__<index> entry.
# Ignored in Development, where any origin is allowed — see docs/SECURITY.md.
Cors__AllowedOrigins__0=http://localhost:5173

# --- JWT (Module 2 — Identity) --------------------------------------------
# Any sufficiently random string for local dev, e.g. `openssl rand -base64 48`.
# Prefer `dotnet user-secrets set "Jwt:SigningKey" ...` over this file for
# an actual local run — see docs/DEVELOPMENT.md.
Jwt__SigningKey=CHANGE_ME

# --- First-run bootstrap (Module 2 — Identity) ----------------------------
# Only used once, when no Super Administrator exists yet. See
# docs/DEVELOPMENT.md "First login".
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_ORGANISATION_NAME=

# --- Local infrastructure (deployment/docker-compose.yml) ----------------
# Only used by the optional "local-db" Compose profile — omit if you're
# using an existing PostgreSQL instance instead (as this project's own
# dev environment does).
POSTGRES_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=dpdp_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME
